{
    "name": "innoboxrr/laravel-uploads",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\LaravelUploads\\": "src/",
            "Innoboxrr\\LaravelUploads\\Database\\Factories\\": "database/factories/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "innoboxrr/larapack-generator": "^7.0",
        "laravel/sanctum": "^4.0"
    },
    "require": {
        "intervention/image": "^3.11",
        "intervention/image-laravel": "^1.2",
        "innoboxrr/traits": "^2.1",
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\LaravelUploads\\Providers\\AppServiceProvider",
                "Innoboxrr\\LaravelUploads\\Providers\\AuthServiceProvider",
                "Innoboxrr\\LaravelUploads\\Providers\\EventServiceProvider",
                "Innoboxrr\\LaravelUploads\\Providers\\RouteServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\LaravelUploads\\Tests\\": "tests/"
        }
    },
    "description": "Subida y gestion de archivos para aplicaciones Laravel."
}
